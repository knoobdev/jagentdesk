# Example child image that adds agent CLIs to the official JAgentDesk image.
#
# Build:
#   docker build -f docker/Dockerfile.agents.example -t jagentdesk-with-agents .
#
# Then set `image: jagentdesk-with-agents` in docker/docker-compose.example.yml.

FROM jagentdesk:local:latest

USER root
RUN npm install -g \
  @anthropic-ai/claude-code \
  @openai/codex \
  opencode-ai

# Leave the image user as root. The base entrypoint prepares mounted volumes,
# then drops the daemon and launched agents to the non-root `jagentdesk` user.

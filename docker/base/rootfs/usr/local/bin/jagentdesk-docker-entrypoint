#!/usr/bin/env bash
set -euo pipefail

IMAGE_HOME="/home/jagentdesk"

: "${HOME:=$IMAGE_HOME}"
: "${JAGENTDESK_HOME:=${HOME}/.jagentdesk}"
: "${JAGENTDESK_LISTEN:=0.0.0.0:6767}"
: "${JAGENTDESK_WEB_UI_ENABLED:=true}"
: "${JAGENTDESK_LOG_LEVEL:=info}"
: "${JAGENTDESK_LOG_FORMAT:=json}"
: "${CLAUDE_CONFIG_DIR:=${HOME}/.claude}"
: "${CODEX_HOME:=${HOME}/.codex}"
: "${XDG_CONFIG_HOME:=${HOME}/.config}"
: "${XDG_DATA_HOME:=${HOME}/.local/share}"
: "${XDG_STATE_HOME:=${HOME}/.local/state}"
: "${XDG_CACHE_HOME:=${HOME}/.cache}"

export HOME
export JAGENTDESK_HOME
export JAGENTDESK_LISTEN
export JAGENTDESK_WEB_UI_ENABLED
export JAGENTDESK_LOG_LEVEL
export JAGENTDESK_LOG_FORMAT
export CLAUDE_CONFIG_DIR
export CODEX_HOME
export XDG_CONFIG_HOME
export XDG_DATA_HOME
export XDG_STATE_HOME
export XDG_CACHE_HOME

ensure_dir() {
  local dir="$1"
  mkdir -p "$dir"
  if [[ "$(id -u)" == "0" ]]; then
    local owner
    owner="$(stat -c "%u" "$dir")"
    if [[ "$owner" == "0" ]]; then
      chown jagentdesk:jagentdesk "$dir"
    fi
  fi
}

ensure_dir "$HOME"
ensure_dir "$JAGENTDESK_HOME"
ensure_dir "$CLAUDE_CONFIG_DIR"
ensure_dir "$CODEX_HOME"
ensure_dir "$XDG_CONFIG_HOME"
ensure_dir "$XDG_DATA_HOME"
ensure_dir "$XDG_STATE_HOME"
ensure_dir "$XDG_CACHE_HOME"

if [[ "$#" -gt 0 ]]; then
  if [[ "$(id -u)" == "0" ]]; then
    exec gosu jagentdesk "$@"
  fi
  exec "$@"
fi

if [[ -z "${JAGENTDESK_PASSWORD:-}" ]]; then
  {
    echo "[jagentdesk] WARNING: JAGENTDESK_PASSWORD is not set."
    echo "[jagentdesk] The daemon accepts unauthenticated control connections from any client that can reach it."
    echo "[jagentdesk] Set JAGENTDESK_PASSWORD for any published port or network-reachable deployment."
  } >&2
fi

if [[ ! -f /etc/jagentdesk-server-entry ]]; then
  echo "[jagentdesk] FATAL: /etc/jagentdesk-server-entry is missing." >&2
  exit 1
fi

entry="$(cat /etc/jagentdesk-server-entry)"
echo "[jagentdesk] starting daemon on ${JAGENTDESK_LISTEN} with web UI ${JAGENTDESK_WEB_UI_ENABLED}"
if [[ "$(id -u)" == "0" ]]; then
  exec gosu jagentdesk node "$entry"
fi
exec node "$entry"

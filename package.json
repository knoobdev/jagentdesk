{
  "name": "jagentdesk",
  "version": "1.0.14",
  "private": true,
  "description": "JAgentDesk: voice-controlled development environment for local AI coding agents",
  "keywords": [
    "development",
    "mcp",
    "openai",
    "voice",
    "voice-assistant"
  ],
  "homepage": "https://github.com/knoobdev/jagentdesk",
  "bugs": {
    "url": "https://github.com/knoobdev/jagentdesk/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "JAgentDesk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/knoobdev/jagentdesk.git"
  },
  "workspaces": [
    "packages/expo-two-way-audio",
    "packages/highlight",
    "packages/protocol",
    "packages/client",
    "packages/server",
    "packages/app",
    "packages/website",
    "packages/desktop",
    "packages/cli"
  ],
  "scripts": {
    "dev": "npm run dev:server",
    "dev:win": "powershell ./scripts/dev.ps1",
    "dev:server": "cross-env JAGENTDESK_LISTEN=127.0.0.1:6768 ./scripts/dev-daemon.sh",
    "dev:server:watch": "concurrently --kill-others --names protocol,client,server --prefix-colors yellow,blue,cyan \"npm run watch:protocol\" \"npm run watch:client\" \"npm run dev:server:raw\"",
    "dev:server:raw": "npm run dev --workspace=@jagentdesk/server",
    "dev:app": "cross-env JAGENTDESK_LISTEN=127.0.0.1:6768 EXPO_PORT=8081 ./scripts/dev-app.sh",
    "test:e2e:mobile": "./scripts/test-mobile-agent-device.sh",
    "dev:website": "npm run dev --workspace=@jagentdesk/website",
    "postinstall": "node scripts/postinstall-patches.mjs",
    "prepare": "lefthook install --force",
    "build": "npm run build --workspaces --if-present",
    "build:highlight": "npm run build --workspace=@jagentdesk/highlight",
    "build:highlight:clean": "npm run build:clean --workspace=@jagentdesk/highlight",
    "build:protocol": "npm run build --workspace=@jagentdesk/protocol",
    "build:protocol:clean": "npm run build:clean --workspace=@jagentdesk/protocol",
    "build:client": "npm run build --workspace=@jagentdesk/client",
    "build:client:clean": "npm run build:protocol:clean && npm run build:clean --workspace=@jagentdesk/client",
    "build:server-deps": "concurrently --kill-others-on-fail --names highlight,client --prefix-colors yellow,blue \"npm run build:highlight\" \"npm run build:client\"",
    "build:server-deps:clean": "npm run build:highlight:clean && npm run build:client:clean",
    "build:server": "npm run build:server-deps && npm run build --workspace=@jagentdesk/server && npm run build --workspace=@jagentdesk/cli",
    "build:server:clean": "npm run build:server-deps:clean && npm run build:clean --workspace=@jagentdesk/server && npm run build:clean --workspace=@jagentdesk/cli",
    "build:daemon-web-ui": "node scripts/build-daemon-web-ui.mjs",
    "build:app-deps": "npm run build:highlight && npm run build:client && npm run build --workspace=@jagentdesk/expo-two-way-audio",
    "build:app-deps:clean": "npm run build:highlight:clean && npm run build:client:clean && npm run build --workspace=@jagentdesk/expo-two-way-audio",
    "watch:protocol": "npm run watch --workspace=@jagentdesk/protocol",
    "watch:client": "tsc -p packages/client/tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:server": "npm run typecheck --workspace=@jagentdesk/protocol && npm run typecheck --workspace=@jagentdesk/client && npm run typecheck --workspace=@jagentdesk/server && npm run typecheck --workspace=@jagentdesk/cli",
    "test": "npm run test --workspaces --if-present",
    "format": "oxfmt .",
    "format:files": "oxfmt",
    "format:check": "oxfmt --check .",
    "format:check:files": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "acp:version-drift": "node scripts/check-acp-catalog-version-drift.mjs",
    "acp:version-drift:check": "node scripts/check-acp-catalog-version-drift.mjs --fail-on-drift",
    "acp:version-drift:update": "node scripts/check-acp-catalog-version-drift.mjs --update",
    "start": "npm run start --workspace=@jagentdesk/server",
    "android": "npm run android --workspace=@jagentdesk/app",
    "android:development": "npm run android:development --workspace=@jagentdesk/app",
    "android:production": "npm run android:production --workspace=@jagentdesk/app",
    "android:release": "npm run android:production --workspace=@jagentdesk/app",
    "android:clear": "npm run android:clear --workspace=@jagentdesk/app",
    "android:clean": "npm run android:clean --workspace=@jagentdesk/app",
    "ios": "npm run ios --workspace=@jagentdesk/app",
    "web": "npm run web --workspace=@jagentdesk/app",
    "dev:desktop": "cross-env JAGENTDESK_LISTEN=127.0.0.1:6768 npm run dev --workspace=@jagentdesk/desktop",
    "dev:win:desktop": "npm run dev:win --workspace=@jagentdesk/desktop",
    "build:desktop": "npm run build:app-deps:clean && cd packages/app && cross-env JAGENTDESK_WEB_PLATFORM=electron npx expo export --platform web && cd ../.. && npm run build --workspace=@jagentdesk/desktop --",
    "db:query": "npm run db:query --workspace=@jagentdesk/server --",
    "cli": "./scripts/dev-home.sh npx tsx packages/cli/src/index.js",
    "version:sync-internal": "node scripts/sync-workspace-versions.mjs"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "@vercel/nft": "^1.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "get-port-cli": "^3.0.0",
    "js-yaml": "^4.1.1",
    "knip": "^5.82.1",
    "lefthook": "^2.1.6",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "oxlint-tsgolint": "^0.22.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "ws": "^8.20.0"
  },
  "overrides": {
    "@codemirror/language": "6.12.4",
    "@codemirror/view": "6.43.6",
    "lightningcss": "1.30.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3"
  }
}
